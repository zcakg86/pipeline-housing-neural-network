{
  "name": "House Price Models and Quarkus App",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "VARIANT": "3.11-bookworm"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "jdkDistro": "ms",
      "installMaven": false
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Quarkus house-price app",
      "protocol": "http",
      "onAutoForward": "notify"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "silent"
  },
  "containerEnv": {
    "TZ": "America/Los_Angeles",
    "PYTHONUNBUFFERED": "1",
    "PIP_DISABLE_PIP_VERSION_CHECK": "1"
  },
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}",
    "PYTHONPATH": "${containerWorkspaceFolder}/src",
    "MPLCONFIGDIR": "${containerWorkspaceFolder}/.cache/matplotlib",
    "QUARKUS_HTTP_HOST": "0.0.0.0"
  },
  "secrets": {
    "RENTCAST_API_KEY": {
      "description": "Optional RentCast API key. Fetches remain protected by the application's call budget and cooldown."
    },
    "ZILLOW_API_KEY": {
      "description": "Optional HasData/Zillow API key used only when the Zillow fetch action is explicitly invoked."
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "java.import.maven.enabled": true,
        "files.exclude": {
          "**/__pycache__": true,
          "**/target": true
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "vscjava.vscode-java-pack",
        "redhat.vscode-quarkus"
      ]
    },
    "codespaces": {
      "openFiles": [
        "README.md",
        "main_train.py",
        "java-app/house-price-app/README.md"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "waitFor": "postCreateCommand",
  "remoteUser": "vscode"
}
